  "description": "StoreEngine is a powerful WordPress eCommerce plugin to create and manage stores. It offers flexible payments, memberships, and seamless integrations.",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build",
    "generate-icons": "fantasticon --normalize",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "wp:pot": "node bin/make-pot.mjs",
    "dist": "node build-tools/build.mjs",
    "dist:zip": "node build-tools/build.mjs --only=zip",
    "dist:dev": "node build-tools/build.mjs --dev",
