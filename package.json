    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:md:js": "wp-scripts lint-md-js",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "start": "wp-scripts start",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-js",
    "wp-env": "wp-env",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop",
    "wp-env:destroy": "wp-env destroy --force",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/storeengine/tests vendor/bin/phpunit -c phpunit-integration.xml.dist",
    "test:integration:pro": "wp-env run tests-cli --env-cwd=wp-content/plugins/storeengine-pro/tests vendor/bin/phpunit -c phpunit-integration.xml.dist"
  },
  "repository": {
    "type": "git",
