{
  "name": "kodezen/storeengine",
  "description": "Empower Your WordPress Store with Seamless eCommerce Solutions!.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/imrantushar/storeengine-sdk-for-wordpress.git"
    }
  ],
  "autoload": {
    "files": [
      "vendor/woocommerce/action-scheduler/action-scheduler.php"
    ]
  },
  "require": {
    "php": "^7.4 || >=8.0",
    "ext-zip": "*",
    "ext-bcmath": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-dom": "*",
    "stripe/stripe-php": "^16.4",
    "woocommerce/action-scheduler": "^3.9",
    "pelago/emogrifier": "^7.3",
    "ext-mysqli": "*",
    "mpdf/mpdf": "^8.2",
    "maxmind-db/reader": "^1.12.1",
    "ext-ctype": "*",
    "storeengine/wordpress-sdk": "^1.6"
  },
  "require-dev": {
    "ext-filter": "*",
    "ext-libxml": "*",
    "ext-tokenizer": "*",
    "ext-xmlreader": "*",
    "squizlabs/php_codesniffer": "^3.13",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.2",
    "pronamic/wp-documentor": "^1.3",
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-stubs/wordpress-stubs": "^6.9"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor/prefixed",
      "namespace_prefix": "StoreEngine\\",
      "classmap_prefix": "StoreEngine_",
      "constant_prefix": "STOREENGINE_",
      "update_call_sites": true,
      "delete_vendor_packages": true,
      "delete_vendor_files": true,
      "include_modified_date": false,
      "override_autoload": {
        "mpdf/mpdf": {
          "psr-4": {
            "Mpdf\\": "src/"
          },
          "files": [
            "src/functions.php"
          ],
          "classmap": [
            "data/",
            "ttfonts/"
          ]
        }
      },
      "exclude_from_copy": {
        "packages": [
          "woocommerce/action-scheduler",
          "storeengine/wordpress-sdk",
          "symfony/polyfill-php80"
        ]
      }
    }
  },
  "scripts": {
    "prefix-namespaces": [
      "@php -r \"is_dir('./../../bin') || mkdir('./../../bin', 0777, true);\"",
      "@php -r \"file_exists('./../../bin/strauss.phar') || copy('https://github.com/BrianHenryIE/strauss/releases/download/0.19.3/strauss.phar', './../../bin/strauss.phar');\"",
      "@php ./../../bin/strauss.phar",
      "@composer dump-autoload -o --classmap-authoritative"
    ],
    "format": "phpcbf --colors --extensions=php ./includes ./addons ./templates",
    "lint": "phpcs --colors --extensions=php ./includes ./addons ./templates",
    "lint:log": "phpcs --colors --extensions=php --report=full --report-file=./phpcs.log ./includes ./addons ./templates",
    "analyze": "phpstan analyse --memory-limit=3048M .",
    "build": "@composer install --no-dev --optimize-autoloader --classmap-authoritative",
    "update": "@composer update --no-dev --optimize-autoloader --classmap-authoritative",
    "dev": "@composer install",
    "wp:gen-pot": "@php -d memory_limit=2G \"$(which wp)\" i18n make-pot . --allow-root --exclude=dev_storeengine/",
    "cache:clear": [
      "@composer clear-cache"
    ],
    "post-install-cmd": [
      "@prefix-namespaces"
    ],
    "post-update-cmd": [
      "@prefix-namespaces"
    ]
  },
  "scripts-descriptions": {
    "format": "Formate php files (phpcbf) as per WPCS rules.",
    "lint": "Check the PHP WPCS (phpcs) violations.",
    "lint:log": "Write lint output to a log file (phpcs.log).",
    "analyze": "Runs PHP Static Analysis (phpstan)",
    "build": "Builds dependencies without dev-dependencies.",
    "dev": "Install all dependencies including dev-dependencies.",
    "wp:gen-pot": "Run WP-CLI pot generator with increased php memory limit.",
    "cache:clear": "Clear Composer caches.",
    "prefix-namespaces": "Internal use. Will auto-run with composer install/update command. Prefix the namespace of required dependency with `StoreEngine`.",
    "post-install-cmd": "Internal use. Runs `prefix-namespaces` after package install.",
    "post-update-cmd": "Internal use. Runs `prefix-namespaces` after package update."
  }
}
